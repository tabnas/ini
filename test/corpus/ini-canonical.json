      "d": "1\\\n2\\\n3\\\n4",
      "e": "1 \\",
      "2 \\": true,
      "3 \\": true,
      "f": "1 ; \\\nhidden = because of the preceding backslash multi-lining the comment ;",
      "visible": "1",
      "g": "1 #\\\nand now this comment is hidden too \\\nand this one too",
      "h": "1",
      "multi \\": true,
      "line \\": true,
      "key": "\\\nmulti \\\nline \\\nvalue ;"
