{
  "go-ini/testdata/full.ini": {
    "NAME": "ini",
    "VERSION": "v1",
    "IMPORT_PATH": "gopkg.in/%(NAME)s.%(VERSION)s",
    "author": {
      "NAME": "Unknwon",
      "E-MAIL": "u@gogs.io",
      "GITHUB": "https://github.com/%(NAME)s",
      "BIO": "\"\"\"Gopher.",
      "Coding addict.": true,
      "Good man.": true,
      "\"  # Succeeding comment": true
    },
    "package": {
      "CLONE_URL": "https://%(IMPORT_PATH)s",
      "sub": {
        "UNUSED_KEY": "should be deleted"
      }
    },
    "features": {
      "-: Support read/write comments of keys and sections": true,
      "-: Support auto-increment of key names": true,
      "-: Support load multiple files to overwrite key values": true
    },
    "types": {
      "STRING": "str",
      "BOOL": true,
      "BOOL_FALSE": false,
      "FLOAT64": "1.25",
      "INT": "10",
      "TIME": "2015-01-01T20:17:05Z",
      "DURATION": "2h45m",
      "UINT": "3",
      "HEX_NUMBER": "0x3000"
    },
    "array": {
      "STRINGS": "en, zh, de",
      "FLOAT64S": "1.1, 2.2, 3.3",
      "INTS": "1, 2, 3",
      "UINTS": "1, 2, 3",
      "TIMES": "2015-01-01T20:17:05Z,2015-01-01T20:17:05Z,2015-01-01T20:17:05Z",
      "BOOLS": "true, false, false"
    },
    "note": {
      "empty_lines": "next line is empty\\"
    },
    "comments": {
      "key": "value",
      "key2": "\"value2\" ; This is a comment for key2",
      "key3": "\"one\", \"two\", \"three\""
    },
    "string escapes": {
      "key1": "value1, value2, value3",
      "key2": "value1\\, value2",
      "key3": "val\\ue1, value2",
      "key4": "value1\\, value\\\\2",
      "key5": "value1\\,, value2",
      "key6": "aaa bbb\\ and\\ space ccc"
    },
    "advance": {
      "value with quotes": "some value",
      "value quote2 again": "some value",
      "includes comment sign": "`my#password`",
      "includes comment sign2": "`my;password`",
      "true": "2+3=5",
      "1+1=2": true,
      "6+1=7": true,
      "": "10",
      "`5+5`": true,
      "`\"6+6\"`": "12",
      "`7-2": "4`                = false",
      "ADDRESS": "`404 road,",
      "NotFound, State, 50000`": true,
      "two_lines": "how about \\\n\tcontinuation lines?",
      "lots_of_lines": "1 \\\n\t2 \\\n\t3 \\\n\t4 \\"
    }
  },
  "inih/examples/test.ini": {
    "protocol": {
      "version": "6                ; IPv6"
    },
    "user": {
      "name": "Bob Smith         ; Spaces around '=' are stripped",
      "email": "bob@smith.com    ; And comments (like this) ignored",
      "active": "true            ; Test a boolean",
      "pi": "3.14159             ; Test a floating point number",
      "trillion": "1000000000000 ; Test 64-bit integers"
    }
  },
  "inih/fuzzing/testcases/case1.ini": {
    "foo": {
      "bar": "1 ; name=value"
    },
    "bar": {
      "name": "Bob",
      "age: 42": true
    }
  },
  "inih/tests/multi_line.ini": {
    "section1": {
      "single1": "abc",
      "multi": "this is a",
      "multi-line value": true,
      "single2": "xyz"
    },
    "section2": {
      "multi": "a",
      "b": true,
      "c": true
    },
    "section3": {
      "single: ghi": true,
      "multi: the quick": true,
      "brown fox": true,
      "name": "bob smith  ; comment line 1",
      "foo": "bar ;c1",
      "Hi World ;c2": true
    }
  },
  "inih/tests/normal.ini": {
    "section1": {
      "one": "This is a test  ; name=value comment",
      "two": "1234"
    },
    "section 2": {
      "happy": "4",
      "sad": ""
    },
    "empty": {},
    "comment_test": {
      "test1": "1;2;3 ; only this will be a comment",
      "test2": "2;3;4;this won't be a comment, needs whitespace before ';'",
      "test;3": "345 ; key should be \"test;3\"",
      "test4": "4#5#6 ; '#' only starts a comment at start of line",
      "test7": "; blank value, except if inline comments disabled",
      "test8": "; not a comment, needs whitespace before ';'"
    },
    "colon_tests": {
      "Content-Type: text/html": true,
      "foo:bar": true,
      "adams : 42": true,
      "funny1 : with": "equals",
      "funny2": "with : colons",
      "funny3": "two = equals",
      "funny4 : two : colons": true
    }
  },
